# Copy this file to .env and fill in your values.
# docker-compose reads from .env automatically.

# ── Database (Supabase or any external PostgreSQL) ────────────────────────────
# Full connection string for the API server.
# Find this in Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Backend ───────────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens. Change this before deploying.
JWT_SECRET=change_me_in_production

# Anthropic API key for the AI-explanation feature (Claude Haiku).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Frontend (Vite build arg) ─────────────────────────────────────────────────
# Public URL the browser uses to reach the API.
# For local Docker: http://localhost:3001
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:3001
